# pub_rs - Variáveis de Ambiente

# (Opcional) Chave de API do Google Gemini para geração de copies com Inteligência Artificial avançada
# Se não fornecida, o pub_rs usará o gerador algorítmico dinâmico integrado (sem custos e sem limites de requisições).
GEMINI_API_KEY=

# (Opcional) Chave OpenAI alternativa
OPENAI_API_KEY=

# (Opcional) URL global padrão para disparo de webhooks (n8n, Make, Metricool, etc)
DEFAULT_WEBHOOK_URL=
